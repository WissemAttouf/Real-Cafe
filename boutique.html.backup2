<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Real Cafe</title>
<meta name="description" content="Café de spécialité à Tunis. Grains torréfiés sur place trois fois par semaine, carte courte, terrasse ouverte sur la rue de la Casbah. Réservation en ligne.">
<link rel="canonical" href="https://realcafe.tn/">

<meta property="og:type" content="website">
<meta property="og:locale" content="fr_TN">
<meta property="og:site_name" content="Real Cafe">
<meta property="og:title" content="Real Cafe — Café de spécialité, Tunis">
<meta property="og:description" content="Grains torréfiés sur place à Tunis. Une carte courte, pensée pour être bonne du premier au dernier café de la journée.">
<meta property="og:url" content="https://realcafe.tn/">
<meta property="og:image" content="https://realcafe.tn/assets/og-cover.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Comptoir en chêne de Real Cafe, Tunis">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Real Cafe — Café de spécialité, Tunis">
<meta name="twitter:description" content="Grains torréfiés sur place à Tunis. Une carte courte, pensée pour être bonne du premier au dernier café de la journée.">
<meta name="twitter:image" content="https://realcafe.tn/assets/og-cover.jpg">

<meta name="theme-color" content="#17130F">

<!-- Favicon -->
<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">

<!-- PWA -->
<link rel="ai-catalog" href="/.well-known/ai-catalog.json">

<!-- Meta iOS -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Real Cafe">

<!-- Meta Android / PWA -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#17130F">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/assets/icons/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Real Cafe">
<meta name="mobile-web-app-capable" content="yes">
<link rel="stylesheet" href="/styles.css">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  "name": "Real Cafe",
  "alternateName": "ريال كافي",
  "image": "https://realcafe.tn/assets/og-cover.jpg",
  "url": "https://realcafe.tn/",
  "telephone": "+21671234567",
  "priceRange": "$$",
  "servesCuisine": ["Café de spécialité", "Pâtisserie"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "12 Rue de la Casbah",
    "addressLocality": "Tunis",
    "postalCode": "1006",
    "addressCountry": "TN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 36.7984, "longitude": 10.1710 },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday"], "opens": "07:00", "closes": "21:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Friday","Saturday"], "opens": "07:00", "closes": "22:30" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "08:00", "closes": "20:00" }
  ],
  "sameAs": [
    "https://www.instagram.com/realcafe",
    "https://www.facebook.com/realcafe"
  ]
}
</script>
</head>
<body>
<!-- PRELOADER -->
<div class="preloader" id="preloader" aria-hidden="true">
  <div class="preloader-inner">
    <svg class="preloader-cup" viewBox="0 0 140 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- La forme intérieure de la tasse, où le liquide doit rester -->
        <clipPath id="cupInner">
          <path d="M25 55 H115 L105 135 A10 10 0 0 1 95 143 H45 A10 10 0 0 1 35 135 Z"/>
        </clipPath>
      </defs>

      <!-- Corps de la tasse (contour) -->
      <path d="M25 55 H115 L105 135 A10 10 0 0 1 95 143 H45 A10 10 0 0 1 35 135 Z"
            stroke="#E4BC72" stroke-width="2.5" fill="none" stroke-linejoin="round"/>

      <!-- Anse -->
      <path d="M115 70 Q135 75 135 95 Q135 115 115 120"
            stroke="#B7AB90" stroke-width="2" fill="none" stroke-linecap="round"/>

      <!-- Ligne de surface (rebord de la tasse) -->
      <line x1="25" y1="55" x2="115" y2="55" stroke="#CE9C49" stroke-width="3" stroke-linecap="round"/>

      <!-- LIQUIDE — rect qui remplit la tasse, clippé par cupInner -->
      <rect class="preloader-liquid"
            x="0"
            y="0"
            width="140"
            height="160"
            fill="#CE9C49"
            clip-path="url(#cupInner)"
            transform="translate(0, 160)"/>
    </svg>

    <div class="preloader-progress">
      <span class="preloader-percent">0</span><span class="preloader-percent-sign">%</span>
    </div>
  </div>
</div>

<a href="#main" class="skip-link" data-i18n="a11y.skip">Aller au contenu</a>

<header id="siteHeader">
  <nav class="wrap">
    <a href="#home" class="logo">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="12" rx="9" ry="10" stroke="currentColor" stroke-width="1.4"/><path d="M12 2.5C9 6 9 18 12 21.5" stroke="currentColor" stroke-width="1.4"/></svg>
      Real Cafe
      <span class="ar" lang="ar" dir="rtl">ريال كافي</span>
    </a>
    <div class="nav-links">
      <a href="#philosophie" data-i18n="nav.coffee">Le café</a>
      <a href="#carte" data-i18n="nav.menu">La carte</a>
      <a href="#galerie" data-i18n="nav.gallery">Galerie</a>
      <a href="#avis" data-i18n="nav.reviews">Avis</a>
      <a href="#infos" data-i18n="nav.info">Infos</a>
    </div>
    <button class="lang-toggle" id="langToggle" aria-label="Changer de langue">
      <span class="lang-current">FR</span>
      <span class="lang-sep">·</span>
      <span class="lang-other">ع</span>
    </button>
    <a href="#reservation" class="nav-cta" data-i18n="nav.book">Réserver une table</a>
    <button class="cart-toggle" id="cartToggle" aria-label="Voir le panier">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="18" height="18">
        <path d="M4 6 H8 L10 16 H18 L20 8 H8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="10" cy="20" r="1.5" fill="currentColor"/>
        <circle cx="18" cy="20" r="1.5" fill="currentColor"/>
      </svg>
      <span class="cart-count" id="cartCount" hidden>0</span>
    </button>
    <button class="burger" id="burgerBtn" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<div class="mobile-panel" id="mobilePanel">
  <a href="#philosophie" data-i18n="nav.coffee">Le café</a>
  <a href="#carte" data-i18n="nav.menu">La carte</a>
  <a href="#galerie" data-i18n="nav.gallery">Galerie</a>
  <a href="#avis" data-i18n="nav.reviews">Avis</a>
  <a href="#infos" data-i18n="nav.info">Infos</a>
  <a href="#reservation" class="nav-cta" data-i18n="nav.book">Réserver une table</a>
  <div class="ar" lang="ar" dir="rtl">ريال كافي</div>
</div>

<main id="main">

  <!-- BOUTIQUE -->
  <section class="shop-hero">
    <div class="wrap">
      <div class="eyebrow-row">
        <h1 class="section-title">La boutique</h1>
        <p class="section-note">Nos cafés torréfiés sur place, livrés partout en Tunisie. Fraîcheur garantie.</p>
      </div>
    </div>
  </section>

  <section class="shop-section">
    <div class="wrap">
      <div class="shop-filters">
        <button type="button" class="shop-filter active" data-filter="all">Tous</button>
        <button type="button" class="shop-filter" data-filter="clair">Torréfaction claire</button>
        <button type="button" class="shop-filter" data-filter="moyen">Torréfaction moyenne</button>
        <button type="button" class="shop-filter" data-filter="fonce">Torréfaction foncée</button>
      </div>

      <div class="shop-grid" id="shopGrid">
        <p class="shop-loading">Chargement des cafés…</p>
      </div>
    </div>
  </section>
  <!-- MODALE FICHE PRODUIT -->
  <div class="product-backdrop" id="productBackdrop"></div>

  <aside class="product-modal" id="productModal" role="dialog" aria-modal="true" aria-labelledby="productModalName" aria-hidden="true">
    <button type="button" class="product-close" id="productClose" aria-label="Fermer">✕</button>

    <div class="product-content">
      <div class="product-image" id="productImage"></div>

      <div class="product-info">
        <span class="product-origin" id="productOrigin"></span>
        <h2 class="product-name" id="productModalName"></h2>
        <p class="product-desc" id="productDesc"></p>

        <div class="product-notes" id="productNotes"></div>

        <!-- Choix du poids -->
        <div class="product-field">
          <label>Poids</label>
          <div class="product-options" id="productWeights">
            <button type="button" class="product-option" data-weight="250g">250g</button>
            <button type="button" class="product-option" data-weight="500g">500g</button>
            <button type="button" class="product-option" data-weight="1kg">1kg</button>
          </div>
        </div>

        <!-- Choix de la mouture -->
        <div class="product-field">
          <label>Mouture</label>
          <div class="product-options" id="productGrinds">
            <button type="button" class="product-option" data-grind="Grain">Grain</button>
            <button type="button" class="product-option" data-grind="Moulu V60">Moulu V60</button>
            <button type="button" class="product-option" data-grind="Moulu espresso">Moulu espresso</button>
            <button type="button" class="product-option" data-grind="Moulu turc">Moulu turc</button>
          </div>
        </div>

        <!-- Quantité -->
        <div class="product-field">
          <label for="productQty">Quantité</label>
          <div class="product-qty">
            <button type="button" class="qty-btn" id="qtyMinus" aria-label="Moins">−</button>
            <input type="number" id="productQty" value="1" min="1" max="20" readonly>
            <button type="button" class="qty-btn" id="qtyPlus" aria-label="Plus">+</button>
          </div>
        </div>

        <!-- Prix -->
        <div class="product-price-row">
          <span class="product-price-label">Total</span>
          <span class="product-price" id="productPrice">0,00 DT</span>
        </div>

        <!-- CTA -->
        <button type="button" class="product-add" id="productAdd">
          Ajouter au panier
        </button>

        <p class="product-stock" id="productStock"></p>
      </div>
    </div>
  </aside>

</main>

<div class="menu-panel-backdrop" id="menuBackdrop"></div>
<aside class="menu-panel" id="menuPanel" role="dialog" aria-modal="true" aria-labelledby="panelName" aria-hidden="true">
  <button type="button" class="panel-close" id="panelClose" aria-label="Fermer">✕</button>
  <div class="panel-content">
    <p class="panel-price" id="panelPrice"></p>
    <h3 id="panelName"></h3>
    <div class="panel-meta" id="panelMeta"></div>
    <div class="panel-notes" id="panelNotes"></div>
    <p class="panel-desc" id="panelDesc"></p>
    <p class="panel-footer">Torréfié sur place · 3×/semaine</p>
  </div>
</aside>

<a href="#reservation" class="float-reserve" id="floatReserve" aria-label="Réserver une table">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="16" height="16">
    <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
  <span class="float-reserve-label">
    <span class="float-reserve-main" data-i18n="float_cta.label">Réserver</span>
    <span class="float-reserve-darija" lang="ar-Latn" data-i18n="float_cta.darija">nchoufou ?</span>
  </span>
</a>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-col">
        <div class="foot-logo">Real Cafe <span class="ar" lang="ar" dir="rtl">ريال كافي</span></div>
        <p data-i18n="footer.address">12 Rue de la Casbah, Tunis. Ouvert tous les jours dès 07h00.</p>
      </div>
      <div class="foot-links">
        <a href="https://www.instagram.com/realcafe" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
        <a href="https://www.facebook.com/realcafe" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>
        <a href="tel:+21671234567" aria-label="Appeler">+216 71 234 567</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© <span id="year"></span> Real Cafe</span>
      <span data-i18n="footer.made_in">Torréfié à Tunis</span>
    </div>
  </div>
</footer>
<script>
  window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
</script>
<script defer src="/_vercel/speed-insights/script.js"></script>

<script type="module" src="/js/main.js"></script>
<script type="module">
  import * as shop from '/js/features/shop.js';
  shop.init();
</script>
</body>
</html>