<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2317130F'/%3E%3Cg transform='translate(16 16)' stroke='%23E4BC72' stroke-width='1.4' fill='none' stroke-linecap='round'%3E%3Ccircle r='2'/%3E%3Cpath d='M0 -2 C 2 -6, 6 -6, 8 -4'/%3E%3Cpath d='M0 -2 C 2 -6, 6 -6, 8 -4' transform='rotate(72)'/%3E%3Cpath d='M0 -2 C 2 -6, 6 -6, 8 -4' transform='rotate(144)'/%3E%3Cpath d='M0 -2 C 2 -6, 6 -6, 8 -4' transform='rotate(216)'/%3E%3Cpath d='M0 -2 C 2 -6, 6 -6, 8 -4' transform='rotate(288)'/%3E%3C/g%3E%3C/svg%3E">

